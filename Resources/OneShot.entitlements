<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Self-signed builds have no Team ID, so the hardened runtime would refuse to load the
         embedded Sparkle.framework. Developer ID builds do not need this but it is harmless. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The hardened runtime blocks the camera and microphone unless these are present. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
